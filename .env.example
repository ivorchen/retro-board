# Session JWT signing key (HS256). Generate with:
#   openssl rand -hex 32
AUTH_SECRET=generate-with-openssl-rand-hex-32

# GitHub OAuth app credentials (https://github.com/settings/developers)
# Authorization callback URL: <APP_URL>/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Public base URL of the app (used for OAuth redirects + magic links)
APP_URL=http://localhost:3000

# Optional: override the SQLite file location (default: ./data/retro-board.db)
# SQLITE_PATH=./data/retro-board.db
